# ============================================================
# Variables de Entorno de Ejemplo para el Backend (Render / Producción / Local)
# ============================================================

# Puerto del servidor (en Render se asigna automáticamente mediante process.env.PORT)
PORT=3000

# Conexión a Base de Datos MySQL / MariaDB (Aiven, TiDB, Clever Cloud o local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=vendeya_db

# Soporte SSL para base de datos en la nube (true para conexiones con SSL, false o vacío para local)
DB_SSL=false

# Clave secreta para firma y verificación de tokens JWT (Obligatoria en producción)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui

# URL del Frontend permitida por CORS (puedes colocar varias URLs separadas por coma)
FRONTEND_URL=http://localhost:5173,https://tu-frontend.vercel.app
